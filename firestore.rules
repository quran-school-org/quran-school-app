rules_version = '2';

// =============================================================================
// Règles Firestore — multi-écoles (schéma schools/{schoolId}/…, rapport §4.3)
// =============================================================================
// Principes :
//  - un compte Firebase Auth ne donne accès à RIEN par lui-même ;
//  - l'accès aux données d'une école exige un document
//    schools/{schoolId}/members/{uid} actif ; le rôle y est lu ;
//  - isolation par construction : tout est sous schools/{schoolId}, et chaque
//    écriture doit porter le bon champ schoolId ;
//  - les comptes, rôles et écoles ne s'écrivent QUE par les Cloud Functions
//    (Admin SDK) : aucun client ne peut créer un membre ni se promouvoir ;
//  - super-admin de la plateforme : claim `superAdmin` (Admin SDK) ;
//  - la racine (anciennes collections incluses) est fermée.
//
// Groupes de rôles (valeurs en arabe, identiques à src/types.ts) :
//   bureau      : مدير, إداري
//   pédagogie   : bureau + مؤطر, مدرس
//   personnel   : pédagogie + متطوع, عامل نظافة / صيانة, أخرى
//   famille     : طالب, ولي أمر (accès limité à linkedStudentIds)
//
// Matrice testée dans tests/emulator/tenant-rules.test.ts.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- outils
    function signedIn() {
      return request.auth != null;
    }

    function isSuper() {
      return signedIn() && request.auth.token.superAdmin == true;
    }

    function mPath(s) {
      return /databases/$(database)/documents/schools/$(s)/members/$(request.auth.uid);
    }

    function member(s) {
      return get(mPath(s)).data;
    }

    // Membre actif de l'école s.
    function isMember(s) {
      return signedIn() && exists(mPath(s)) && member(s).isActive == true;
    }

    function hasRole(s, roles) {
      return isMember(s) && member(s).role in roles;
    }

    function isDirector(s) {
      return hasRole(s, ['مدير']);
    }

    function isOffice(s) {
      return hasRole(s, ['مدير', 'إداري']);
    }

    function isEducator(s) {
      return hasRole(s, ['مدير', 'إداري', 'مؤطر', 'مدرس']);
    }

    function isCoordinator(s) {
      return hasRole(s, ['مدير', 'إداري', 'مؤطر']);
    }

    function isStaff(s) {
      return hasRole(s, ['مدير', 'إداري', 'مؤطر', 'مدرس', 'متطوع', 'عامل نظافة / صيانة', 'أخرى']);
    }

    function isFamily(s) {
      return hasRole(s, ['طالب', 'ولي أمر']);
    }

    function isParent(s) {
      return hasRole(s, ['ولي أمر']);
    }

    function linkedStudents(s) {
      return member(s).get('linkedStudentIds', []);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Écriture d'un document de l'école s : bon schoolId, jamais de mot de passe.
    function validWrite(s, id) {
      return isValidId(id)
        && request.resource.data.schoolId == s
        && !('password' in request.resource.data);
    }

    // Document d'élève lié au compte famille (lecture filtrée sur studentId).
    function familyOwnsDoc(s) {
      return isFamily(s) && resource.data.studentId in linkedStudents(s);
    }

    // --------------------------------------------- profil global users/{uid}
    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isSuper();
      allow list: if isSuper();
      allow create, delete: if false; // Cloud Functions uniquement
      // Champs anodins de SON profil ; on ne peut que lever l'obligation de
      // changer le mot de passe, jamais modifier ses écoles ou son identifiant.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastSchoolId', 'mustChangePassword', 'passwordChangedAt', 'lastLogin'])
        && (!('mustChangePassword' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.mustChangePassword == false)
        && (request.resource.data.get('lastSchoolId', null) == null
            || request.resource.data.lastSchoolId in resource.data.get('schoolIds', []));
    }

    // Registre global des noms d'utilisateur : Cloud Functions uniquement.
    match /usernames/{username} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------- écoles
    match /schools/{s} {
      allow get: if isMember(s) || isSuper();
      allow list: if isSuper();
      allow create, delete: if false; // createSchool (Cloud Function, super-admin)
      allow update: if (isSuper() || isDirector(s))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'logo', 'updatedAt']);

      // Appartenances : écrites par les Cloud Functions (createSchoolUser,
      // setMemberRole). Chacun lit la sienne ; le bureau lit celles de l'école.
      match /members/{uid} {
        allow get: if (signedIn() && request.auth.uid == uid) || isOffice(s) || isSuper();
        allow list: if isOffice(s) || isSuper();
        allow create, delete: if false;
        allow update: if isMember(s) && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin', 'fullName', 'phone']);
      }

      // Paramètres et identité de l'école.
      match /settings/{docId} {
        allow read: if isMember(s) || isSuper();
        allow write: if (isDirector(s) || isSuper()) && validWrite(s, docId);
      }

      // ------------------------------------------------------------ élèves
      match /students/{studentId} {
        allow get: if isEducator(s) || (isFamily(s) && studentId in linkedStudents(s));
        allow list: if isEducator(s);
        allow create, update: if isEducator(s) && validWrite(s, studentId);
        allow delete: if isOffice(s);
      }

      // ------------------------------------------------ personnel et halaqas
      match /teachers/{teacherId} {
        allow read: if isEducator(s);
        allow write: if isOffice(s) && validWrite(s, teacherId);
        allow delete: if isOffice(s);
      }

      match /classes/{classId} {
        allow read: if isMember(s);
        allow create, update: if isCoordinator(s) && validWrite(s, classId);
        allow delete: if isOffice(s);
      }

      // ----------------------------------------------------------- pédagogie
      match /attendance/{attendanceId} {
        allow read: if isEducator(s) || familyOwnsDoc(s);
        allow create, update: if isEducator(s) && validWrite(s, attendanceId);
        allow delete: if isOffice(s);
      }

      match /grades/{gradeId} {
        allow read: if isEducator(s) || familyOwnsDoc(s);
        allow create, update: if isEducator(s) && validWrite(s, gradeId);
        allow delete: if isOffice(s);
      }

      match /dailyProgress/{progressId} {
        allow read: if isEducator(s) || familyOwnsDoc(s);
        allow create, update: if isEducator(s) && validWrite(s, progressId);
        allow delete: if isEducator(s);
      }

      // ----------------------------------------------------------- finances
      // Bureau uniquement ; un parent lit les cotisations de SES enfants.
      match /payments/{paymentId} {
        allow read: if isOffice(s) || (isParent(s) && resource.data.studentId in linkedStudents(s));
        allow create, update: if isOffice(s) && validWrite(s, paymentId);
        allow delete: if isOffice(s);
      }

      match /otherIncomes/{incomeId} {
        allow read: if isOffice(s);
        allow create, update: if isOffice(s) && validWrite(s, incomeId);
        allow delete: if isOffice(s);
      }

      match /salaryPayments/{salaryId} {
        allow read: if isOffice(s);
        allow create, update: if isOffice(s) && validWrite(s, salaryId);
        allow delete: if isOffice(s);
      }

      match /expenses/{expenseId} {
        allow read: if isOffice(s);
        allow create, update: if isOffice(s) && validWrite(s, expenseId);
        allow delete: if isOffice(s);
      }

      // ------------------------------------------------ activités et sorties
      match /activities/{activityId} {
        allow read: if isMember(s);
        allow create, update: if isEducator(s) && validWrite(s, activityId);
        allow delete: if isOffice(s);
      }

      match /activityParticipants/{participantId} {
        allow read: if hasRole(s, ['مدير', 'إداري', 'مؤطر', 'مدرس', 'متطوع']);
        allow create, update: if isEducator(s) && validWrite(s, participantId);
        allow delete: if isEducator(s);
      }

      match /activityExpenses/{expenseId} {
        allow read: if isEducator(s);
        allow create, update: if isEducator(s) && validWrite(s, expenseId);
        allow delete: if isEducator(s);
      }

      // ------------------------------------------------------- notifications
      match /notifications/{notificationId} {
        allow read: if isStaff(s);
        allow create: if isMember(s) && validWrite(s, notificationId);
        allow update: if isStaff(s) && validWrite(s, notificationId);
        allow delete: if isOffice(s);
      }
    }

    // Racine fermée : anciennes collections (students, appUsers, authLinks…)
    // et tout chemin non prévu ci-dessus. La migration et le retour arrière
    // passent par l'Admin SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
