rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Rules for students collection
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(studentId);
    }

    // Rules for teachers collection
    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(teacherId);
    }

    // Rules for classes collection
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(classId);
    }

    // Rules for attendance collection
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(attendanceId);
    }

    // Rules for grades collection
    match /grades/{gradeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(gradeId);
    }

    // Rules for payments collection
    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(paymentId);
    }

    // Rules for notifications collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(notificationId);
    }

    // Rules for settings collection
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(settingsId);
    }

    // Rules for appUsers collection
    match /appUsers/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(userId);
    }

    // Rules for dailyProgress collection
    match /dailyProgress/{progressId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(progressId);
    }

    // Rules for accounting & finance collections
    match /otherIncomes/{incomeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(incomeId);
    }

    match /salaryPayments/{salaryId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(salaryId);
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(expenseId);
    }

    // Rules for activities & trips collections
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(activityId);
    }

    match /activityParticipants/{participantId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(participantId);
    }

    match /activityExpenses/{expenseId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(expenseId);
    }
  }
}
