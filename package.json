{
  "name": "quran-school-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "emulators": "npm run build:functions && firebase emulators:start --project demo-quran-school",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:dev": "vite build --mode development",
    "build:functions": "npm --prefix functions run build",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:functions": "npm --prefix functions run lint",
    "test": "vitest run --dir tests/unit",
    "test:rules": "npm run build:functions && firebase emulators:exec --only firestore,auth,functions --project demo-quran-school \"vitest run --dir tests/emulator && npm --prefix functions test\"",
    "test:all": "npm run test && npm run test:rules",
    "emulators:persist": "npm run build:functions && firebase emulators:start --project demo-quran-school --import=./emulator-data --export-on-exit=./emulator-data",
    "seed:emulator": "tsx scripts/dev/seed-emulator.ts",
    "test:e2e": "npm run build:functions && firebase emulators:exec --only auth,firestore,functions --project demo-quran-school \"npm run seed:emulator && playwright test\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.56.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    },
    "gaxios@6": {
      "uuid": "^11.1.1"
    }
  }
}
